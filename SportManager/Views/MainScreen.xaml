<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportManager.Views.MainScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Text="SPORT MANAGER"
                       Style="{StaticResource Headline}"
                       VerticalOptions="Start"
                       HorizontalOptions="Start"
                       Grid.Column="0"
                       Margin="14,14,0,0"/>
        <VerticalStackLayout 
            Grid.Row="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="15">
        
            <Button Text="Gestion Equipe"
                    Height ="25"
                    Width = "80"
                    Margin ="2"
                    FontSize="25"
                    Command="{Binding ButtonGestionEquipe}"/>
        
            <Button Text="Jouer match"
                    Height ="25"
                    Width = "80"
                    Margin ="2"
                    FontSize="25"
                    Command="{Binding ButtonJouerMatch}"/>
        
            <Button Text="Historique"
                    Height ="25"
                    Width = "80"
                    Margin ="2"
                    FontSize="25"
                    Command="{Binding ButtonHistorique}"/>
        
        </VerticalStackLayout>
    </Grid>
</ContentPage>