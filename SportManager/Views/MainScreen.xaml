<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportManager.Views.MainScreen"
             Title="SportManager">
    <Grid BackgroundColor="#3A3A3A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <VerticalStackLayout 
            Grid.Row="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="15">
        
            <Button Text="Gestion Equipe"
                    WidthRequest="200"
                    HeightRequest="50"
                    BackgroundColor="#F28C57"
                    TextColor="Black"
                    Clicked="OnGestionEquipeClicked"/>
        
            <Button Text="Jouer match"
                    WidthRequest="200"
                    HeightRequest="50"
                    BackgroundColor="#F28C57"
                    TextColor="Black"
                    Clicked="OnJouerMatchClicked"/>
        
            <Button Text="Historique"
                    WidthRequest="200"
                    HeightRequest="50"
                    BackgroundColor="#F28C57"
                    TextColor="Black"
                    Clicked="OnHistoriqueClicked"/>
        
        </VerticalStackLayout>
    </Grid>
</ContentPage>