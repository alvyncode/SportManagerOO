<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportManager.Views.GestionMatch"
             BackgroundColor="#2F2F2F">

    <Grid Padding="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Text="JOUER UN MATCH"
               Style="{StaticResource Headline}"
               VerticalOptions="Start"
               HorizontalOptions="Start"
               Margin="14,14,0,0"/>

        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="26">

            <Grid ColumnSpacing="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <HorizontalStackLayout Grid.Column="0">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Score" TextColor="White"/>
                        <Label Text="{Binding ScoreEquipeGaucheAffiche}" TextColor="White"/>
                    </VerticalStackLayout>

                    <Border WidthRequest="500"
                            HorizontalOptions="Center"
                            Margin="10"
                            BackgroundColor="#F59A63"
                            StrokeThickness="0"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Picker Title="EQUIPE 1"
                                TitleColor="Black"
                                TextColor="Black"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                ItemsSource="{Binding Equipes}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding Equipe1Selectionnee}" />
                    </Border>
                </HorizontalStackLayout>

                <Label Grid.Column="1"
                       Text="-"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <HorizontalStackLayout Grid.Column="2">
                    <Border WidthRequest="500"
                            HorizontalOptions="Center"
                            Margin="10"
                            BackgroundColor="#F59A63"
                            StrokeThickness="0"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Picker Title="EQUIPE 2"
                                TitleColor="Black"
                                TextColor="Black"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                ItemsSource="{Binding Equipes}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding Equipe2Selectionnee}" />
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Score" TextColor="White"/>
                        <Label Text="{Binding ScoreEquipeDroiteAffiche}" TextColor="White"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Grid>

            <Button Text="JOUER"
                    Width="50"
                    Padding="15"
                    CornerRadius="15"
                    BackgroundColor="#F59A63"
                    TextColor="Black"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Command="{Binding JouerMatchCommand}" />

            <VerticalStackLayout IsVisible="{Binding HasJoueursBlesses}"
                                 Spacing="8">
                <Label Text="Joueurs blesses"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding JoueursBlessesAffiches}"
                                HeightRequest="130">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}"
                                   TextColor="#FFD7B8"
                                   FontSize="16"
                                   HorizontalOptions="Center" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
